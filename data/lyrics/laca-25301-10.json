  "notes": [
    "Stella는 별을 뜻하는 표현으로 번역했습니다.",
    "입력 파일명에는 colors 버전 표기가 없어 앨범 목록의 해당 팀 곡에 연결했습니다. 제공 원문을 사용했으며 해당 버전의 가창·파트 배분은 음원과 대조하지 않았습니다."
  ],
  "stanzas": [
    {
      "number": 1,
      "lines": [
        {
          "number": 1,
          "original": "キラリ光れ！ジブンだけの星の色で！",
          "pronunciation": "키라리 히카레! 지분다케노 호시노 이로데!",
          "translation": "반짝 빛나라! 나만의 별빛으로!"
        }
      ]
    },
    {
      "number": 2,
      "lines": [
        {
          "number": 2,
          "original": "見上げた小さな光の",
          "pronunciation": "미아게타 치이사나 히카리노",
          "translation": "올려다본 작은 빛"
        },
        {
          "number": 3,
          "original": "ひとつひとつに名前があると気づいたら",
          "pronunciation": "히토츠 히토츠니 나마에가 아루토 키즈이타라",
          "translation": "하나하나에 이름이 있음을 깨닫고 나니"
        },
        {
          "number": 4,
          "original": "瞬くみたいな輝き",
          "pronunciation": "마타타쿠 미타이나 카가야키",
          "translation": "깜빡이는 듯한 반짝임이"
        },
        {
          "number": 5,
          "original": "目と目があったみたいに感じるんだよ",
          "pronunciation": "메토 메가 앗타 미타이니 칸지룬다요",
          "translation": "서로 눈이 마주친 것처럼 느껴져"
        }
      ]
    },
    {
      "number": 3,
      "lines": [
        {
          "number": 6,
          "original": "星座盤を空に重ねあわすように",
          "pronunciation": "세이자반오 소라니 카사네아와스 요오니",
          "translation": "별자리판을 하늘에 겹쳐 맞추듯"
        },
        {
          "number": 7,
          "original": "いま、夢に願いを重ねているんだ",
          "pronunciation": "이마 유메니 네가이오 카사네테이룬다",
          "translation": "지금 꿈에 소원을 포개고 있어"
        }
      ]
    },
    {
      "number": 4,
      "lines": [
        {
          "number": 8,
          "original": "キラリ光れ！いろんな色があるんだから",
          "pronunciation": "키라리 히카레! 이론나 이로가 아룬다카라",
          "translation": "반짝 빛나라! 갖가지 빛깔이 있으니까"
        },
        {
          "number": 9,
          "original": "見つけだそうよ　ジブンだけのStella",
          "pronunciation": "미츠케다소오요 지분다케노 스텔라",
          "translation": "찾아내자, 나만의 별을"
        },
        {
          "number": 10,
          "original": "繋がってる想いのカタチたどっていこう",
          "pronunciation": "츠나갓테루 오모이노 카타치 타돗테이코오",
          "translation": "이어진 마음의 모양을 따라가자"
        },
        {
          "number": 11,
          "original": "そこにきっとわたしの名前があるんだね！",
          "pronunciation": "소코니 킷토 와타시노 나마에가 아룬다네!",
          "translation": "그곳에 분명 내 이름이 있겠지!"
        }
      ]
    },
    {
      "number": 5,
      "lines": [
        {
          "number": 12,
          "original": "キラリ光れ！ジブンだけの星の色で！",
          "pronunciation": "키라리 히카레! 지분다케노 호시노 이로데!",
          "translation": "반짝 빛나라! 나만의 별빛으로!"
        }
      ]
    },
    {
      "number": 6,
      "lines": [
        {
          "number": 13,
          "original": "帰り道いっしょに探して",
          "pronunciation": "카에리미치 잇쇼니 사가시테",
          "translation": "돌아가는 길에 함께 찾으며"
        },
        {
          "number": 14,
          "original": "指差してた場所はみんな違ってた",
          "pronunciation": "유비사시테타 바쇼와 민나 치갓테타",
          "translation": "손가락으로 가리킨 곳은 모두 달랐어"
        },
        {
          "number": 15,
          "original": "満天のスクリーン映ってる",
          "pronunciation": "만텐노 스쿠리인 우츳테루",
          "translation": "온 하늘의 스크린에 비치는"
        },
        {
          "number": 16,
          "original": "物語はいくつあってもいいんだ",
          "pronunciation": "모노가타리와 이쿠츠 앗테모 이인다",
          "translation": "이야기는 몇 개든 있어도 좋아"
        }
      ]
    },
    {
      "number": 7,
      "lines": [
        {
          "number": 17,
          "original": "星座盤に描かれてはいなくたって",
          "pronunciation": "세이자반니 에가카레테와 이나쿠탓테",
          "translation": "별자리판에 그려져 있지 않아도"
        },
        {
          "number": 18,
          "original": "いま、赤い糸で結び合わすんだ",
          "pronunciation": "이마 아카이 이토데 무스비아와슨다",
          "translation": "지금 붉은 실로 서로 이어가는 거야"
        }
      ]
    },
    {
      "number": 8,
      "lines": [
        {
          "number": 19,
          "original": "キラリ光れ！このココロときめかせて",
          "pronunciation": "키라리 히카레! 코노 코코로 토키메카세테",
          "translation": "반짝 빛나라! 이 마음을 두근거리게 해줘"
        },
        {
          "number": 20,
          "original": "見つけてみたい　ジブンだけのStory",
          "pronunciation": "미츠케테미타이 지분다케노 스토리",
          "translation": "찾아보고 싶어, 나만의 이야기를"
        },
        {
          "number": 21,
          "original": "伝わってる想いがあると信じてる",
          "pronunciation": "츠타왓테루 오모이가 아루토 신지테루",
          "translation": "전해지고 있는 마음이 있다고 믿어"
        },
        {
          "number": 22,
          "original": "だからきっと呼んでいる声が聴こえるの",
          "pronunciation": "다카라 킷토 욘데이루 코에가 키코에루노",
          "translation": "그래서 분명 부르는 목소리가 들리는 거야"
        }
      ]
    },
    {
      "number": 9,
      "lines": [
        {
          "number": 23,
          "original": "どんなに遠くたって届くことを",
          "pronunciation": "돈나니 토오쿠탓테 토도쿠 코토오",
          "translation": "아무리 멀어도 전해진다는 걸"
        },
        {
          "number": 24,
          "original": "教えてくれてたんだね",
          "pronunciation": "오시에테쿠레테탄다네",
          "translation": "가르쳐 주고 있었구나"
        },
        {
          "number": 25,
          "original": "星は何光年も超えて胸に飛び込んだ",
          "pronunciation": "호시와 난코오넨모 코에테 무네니 토비콘다",
          "translation": "별은 몇 광년이나 넘어 가슴에 뛰어들었어"
        },
        {
          "number": 26,
          "original": "そうだよ、数えても数えきれない",
          "pronunciation": "소오다요 카조에테모 카조에키레나이",
          "translation": "그래, 세어도 다 셀 수 없을"
        },
        {
          "number": 27,
          "original": "ほどの煌めきのなか",
          "pronunciation": "호도노 키라메키노 나카",
          "translation": "만큼 수많은 반짝임 속에서"
        },
        {
          "number": 28,
          "original": "出会えたっていう奇跡を",
          "pronunciation": "데아에탓테 이우 키세키오",
          "translation": "만났다는 이 기적을"
        },
        {
          "number": 29,
          "original": "ジブンだけの色にしよう",
          "pronunciation": "지분다케노 이로니 시요오",
          "translation": "나만의 빛깔로 만들자"
        }
      ]
    },
    {
      "number": 10,
      "lines": [
        {
          "number": 30,
          "original": "キラリ光れ！その瞳に映るように",
          "pronunciation": "키라리 히카레! 소노 히토미니 우츠루 요오니",
          "translation": "반짝 빛나라! 그 눈동자에 비치도록"
        },
        {
          "number": 31,
          "original": "見つけて欲しい　わたしたちのStella",
          "pronunciation": "미츠케테 호시이 와타시타치노 스텔라",
          "translation": "찾아주면 좋겠어, 우리들의 별을"
        },
        {
          "number": 32,
          "original": "ひとつひとついろんな色で羽ばたいて",
          "pronunciation": "히토츠 히토츠 이론나 이로데 하바타이테",
          "translation": "하나하나 저마다의 빛깔로 날갯짓하며"
        },
        {
          "number": 33,
          "original": "想いはきっとあの星のように輝くの",
          "pronunciation": "오모이와 킷토 아노 호시노 요오니 카가야쿠노",
          "translation": "마음은 분명 저 별처럼 빛날 거야"
        }
      ]
    },
    {
      "number": 11,
      "lines": [
        {
          "number": 34,
          "original": "キラリ光れ！ジブンだけの星の色で！",
          "pronunciation": "키라리 히카레! 지분다케노 호시노 이로데!",
          "translation": "반짝 빛나라! 나만의 별빛으로!"
        }
      ]
    }
  ]
