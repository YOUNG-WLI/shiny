        },
        {
          "number": 28,
          "original": "駆け抜けた先には",
          "pronunciation": "카케누케타 사키니와",
          "translation": "달려 나간 그곳에는"
        },
        {
          "number": 29,
          "original": "空と海がスクランブル",
          "pronunciation": "소라토 우미가 스쿠란부루",
