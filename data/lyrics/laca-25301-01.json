  },
  "notes": [
    "ビビデバブ는 주문으로 보고 '비비데바부'로 유지했습니다.",
    "IMAGE는 일본어 'イメージ'로, BELIEVE는 영어 'believe'로 읽는 것으로 가정했습니다. 실제 가창의 발음과 길이는 음원 확인이 필요합니다."
  ],
  "stanzas": [
    {
      "number": 1,
      "lines": [
        {
          "number": 1,
          "original": "気づいたら不思議な森の奥",
          "pronunciation": "키즈이타라 후시기나 모리노 오쿠",
          "translation": "정신을 차려 보니 신비한 숲속 깊은 곳"
        },
        {
          "number": 2,
          "original": "(ここはどこなの？)",
          "pronunciation": "(코코와 도코나노?)",
          "translation": "(여기는 어디지?)"
        },
        {
          "number": 3,
          "original": "帰り道は音もなく消えた",
          "pronunciation": "카에리미치와 오토모 나쿠 키에타",
          "translation": "돌아갈 길은 소리도 없이 사라졌어"
        },
        {
          "number": 4,
          "original": "(進まなきゃ)",
          "pronunciation": "(스스마나캬)",
          "translation": "(앞으로 가야 해)"
        }
      ]
    },
    {
      "number": 2,
      "lines": [
        {
          "number": 5,
          "original": "ピンクのハトが飛んで(ah- a-)",
          "pronunciation": "핑쿠노 하토가 톤데 (아- 아-)",
          "translation": "분홍빛 비둘기가 날아가고 (아- 아-)"
        },
        {
          "number": 6,
          "original": "羽根がひとつビビデバブ",
          "pronunciation": "하네가 히토츠 비비데바부",
          "translation": "깃털 하나가, 비비데바부"
        },
        {
          "number": 7,
          "original": "一瞬で(わぁ)",
          "pronunciation": "잇슌데 (와아)",
          "translation": "눈 깜짝할 사이에 (와아)"
        },
        {
          "number": 8,
          "original": "ドレスアップ(It's a miracle！)",
          "pronunciation": "도레스 앗푸 (잇츠 어 미러클!)",
          "translation": "드레스로 변신! (기적이야!)"
        }
      ]
    },
    {
      "number": 3,
      "lines": [
        {
          "number": 9,
          "original": "「こっち(come on)おいで」と",
          "pronunciation": "「콧치 (컴 온) 오이데」토",
          "translation": "“이쪽으로 (어서) 와” 하며"
        },
        {
          "number": 10,
          "original": "(come on)青いバタフライ",
          "pronunciation": "(컴 온) 아오이 바타후라이",
          "translation": "(어서) 파란 나비가 부르네"
        },
        {
          "number": 11,
          "original": "追いかけた先には",
          "pronunciation": "오이카케타 사키니와",
          "translation": "뒤쫓아간 그곳에는"
        },
        {
          "number": 12,
          "original": "煌めく星　ショーとカーニバル(WOW)",
          "pronunciation": "키라메쿠 호시 쇼오토 카아니바루 (와우)",
          "translation": "반짝이는 별, 쇼와 카니발 (와아)"
        }
      ]
    },
    {
      "number": 4,
      "lines": [
        {
          "number": 13,
          "original": "IMAGEだけが未来地図",
          "pronunciation": "이메에지다케가 미라이 치즈",
          "translation": "상상만이 미래의 지도"
        },
        {
          "number": 14,
          "original": "トキメキと期待が咲く小道",
          "pronunciation": "토키메키토 키타이가 사쿠 코미치",
          "translation": "설렘과 기대가 피어나는 오솔길"
        },
        {
          "number": 15,
          "original": "今あなたがいるその場所も",
          "pronunciation": "이마 아나타가 이루 소노 바쇼모",
          "translation": "지금 네가 있는 그곳도"
        },
        {
          "number": 16,
          "original": "魔法の森なんだって気づいてる？",
          "pronunciation": "마호오노 모리난닷테 키즈이테루?",
          "translation": "마법의 숲이라는 걸 알고 있니?"
        },
        {
          "number": 17,
          "original": "(So magic magic so follow me！)",
          "pronunciation": "(소 매직 매직 소 팔로우 미!)",
          "translation": "(정말 마법 같아, 마법 같아, 그러니 날 따라와!)"
        }
      ]
    },
    {
      "number": 5,
      "lines": [
        {
          "number": 18,
          "original": "生い茂る　光をかき分けて",
          "pronunciation": "오이시게루 히카리오 카키와케테",
          "translation": "무성하게 자란 빛을 헤치고"
        },
        {
          "number": 19,
          "original": "(ねぇついて来て)",
          "pronunciation": "(네에 츠이테 키테)",
          "translation": "(있지, 따라와)"
        },
        {
          "number": 20,
          "original": "愛と音が　暮らすお家でパーティー",
          "pronunciation": "아이토 오토가 쿠라스 오우치데 파아티이",
          "translation": "사랑과 소리가 사는 집에서 파티를"
        },
        {
          "number": 21,
          "original": "(踊りましょう)",
          "pronunciation": "(오도리마쇼오)",
          "translation": "(함께 춤춰요)"
        }
      ]
    },
    {
      "number": 6,
      "lines": [
        {
          "number": 22,
          "original": "夢の木の実をがぶり(ah- a-)",
