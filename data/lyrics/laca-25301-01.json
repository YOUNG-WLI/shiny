    {
      "number": 8,
      "lines": [
        {
          "number": 32,
          "original": "BELIEVEだけが羅針盤",
          "pronunciation": "빌리브다케가 라신반",
          "translation": "믿음만이 나침반"
        },
        {
          "number": 33,
          "original": "ドキドキと奇跡が降る岬",
